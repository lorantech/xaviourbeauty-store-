PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/xaviourbeautystore
JWT_SECRET=change_me_to_a_long_random_string
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@xaviourbeautystore.com
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# The backend REQUIRES MONGODB_URI to be set. If it is missing the process
# refuses to start, instead of silently falling back to an in-memory
# MongoDB that serves empty data and hides deployment misconfiguration.
#
# For throwaway local data only, set USE_MEMORY_DB=true to opt in to
# mongodb-memory-server. That database is NOT shared between processes and is
# discarded on exit, so `npm run seed` data would not appear in the running
# dev server. Always point MONGODB_URI at a real MongoDB instance for
# local development.
USE_MEMORY_DB=false

